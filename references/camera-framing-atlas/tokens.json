{
  "$description": "Camera Framing Atlas preview tokens. Values describe this authored web gallery, not a physical camera or a recovered source design system.",
  "base": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": ["ui-sans-serif", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"],
      "$description": "System UI stack for an inspectable static gallery.",
      "$extensions": { "reference-ui": { "css_name": "--font-sans", "theme": "base" } }
    },
    "bg": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.9569, 0.9412, 0.9098], "alpha": 1 },
      "$description": "Warm neutral gallery canvas.",
      "$extensions": { "reference-ui": { "css_name": "--bg", "theme": "base" } }
    },
    "surface": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [1, 0.9922, 0.9686], "alpha": 1 },
      "$description": "Readable card and control surface.",
      "$extensions": { "reference-ui": { "css_name": "--surface", "theme": "base" } }
    },
    "text": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.0902, 0.2, 0.1882], "alpha": 1 },
      "$description": "Primary text and active control ink.",
      "$extensions": { "reference-ui": { "css_name": "--text", "theme": "base" } }
    },
    "muted": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.3765, 0.4549, 0.4275], "alpha": 1 },
      "$description": "Supporting text and metadata.",
      "$extensions": { "reference-ui": { "css_name": "--muted", "theme": "base" } }
    },
    "line": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.7961, 0.8275, 0.7843], "alpha": 1 },
      "$description": "Card, divider, and focus-adjacent border.",
      "$extensions": { "reference-ui": { "css_name": "--line", "theme": "base" } }
    },
    "accent": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.7255, 0.3647, 0.2863], "alpha": 1 },
      "$description": "Warm subject accent used by authored diagrams.",
      "$extensions": { "reference-ui": { "css_name": "--accent", "theme": "base" } }
    },
    "accent-2": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.8941, 0.6588, 0.4588], "alpha": 1 },
      "$description": "Secondary ambient accent.",
      "$extensions": { "reference-ui": { "css_name": "--accent-2", "theme": "base" } }
    },
    "focus": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.1765, 0.498, 0.5882], "alpha": 1 },
      "$description": "Visible keyboard focus ring.",
      "$extensions": { "reference-ui": { "css_name": "--focus", "theme": "base" } }
    },
    "radius": {
      "$type": "dimension",
      "$value": { "value": 18, "unit": "px" },
      "$description": "Card radius.",
      "$extensions": { "reference-ui": { "css_name": "--radius", "theme": "base" } }
    },
    "gap": {
      "$type": "dimension",
      "$value": { "value": 18, "unit": "px" },
      "$description": "Card grid gap.",
      "$extensions": { "reference-ui": { "css_name": "--gap", "theme": "base" } }
    },
    "control": {
      "$type": "dimension",
      "$value": { "value": 44, "unit": "px" },
      "$description": "Minimum meaningful control target.",
      "$extensions": { "reference-ui": { "css_name": "--control", "theme": "base" } }
    },
    "motion": {
      "$type": "duration",
      "$value": { "value": 180, "unit": "ms" },
      "$description": "Optional feedback transition; reduced motion disables it.",
      "$extensions": { "reference-ui": { "css_name": "--motion", "theme": "base" } }
    }
  },
  "dark": {
    "bg": {
      "$value": { "colorSpace": "srgb", "components": [0.0902, 0.1333, 0.1216], "alpha": 1 },
      "$description": "Dark gallery canvas.",
      "$extensions": { "reference-ui": { "css_name": "--bg", "theme": "dark" } },
      "$type": "color"
    },
    "surface": {
      "$value": { "colorSpace": "srgb", "components": [0.1373, 0.2, 0.1843], "alpha": 1 },
      "$description": "Dark readable surface.",
      "$extensions": { "reference-ui": { "css_name": "--surface", "theme": "dark" } },
      "$type": "color"
    },
    "text": {
      "$value": { "colorSpace": "srgb", "components": [0.9294, 0.9451, 0.9098], "alpha": 1 },

      "$extensions": { "reference-ui": { "css_name": "--text", "theme": "dark" } },
      "$type": "color"
    },
    "muted": {
      "$value": { "colorSpace": "srgb", "components": [0.6902, 0.7569, 0.7255], "alpha": 1 },
      "$description": "Dark-mode supporting text.",
      "$extensions": { "reference-ui": { "css_name": "--muted", "theme": "dark" } },
      "$type": "color"
    },
    "line": {
      "$value": { "colorSpace": "srgb", "components": [0.2941, 0.3961, 0.3647], "alpha": 1 },
      "$description": "Dark-mode borders.",
      "$extensions": { "reference-ui": { "css_name": "--line", "theme": "dark" } },
      "$type": "color"
    },
    "accent": {
      "$value": { "colorSpace": "srgb", "components": [0.8863, 0.6275, 0.5294], "alpha": 1 },
      "$description": "Dark-mode subject accent.",
      "$extensions": { "reference-ui": { "css_name": "--accent", "theme": "dark" } },
      "$type": "color"
    },
    "accent-2": {
      "$value": { "colorSpace": "srgb", "components": [0.9294, 0.7686, 0.4549], "alpha": 1 },
      "$description": "Dark-mode ambient accent.",
      "$extensions": { "reference-ui": { "css_name": "--accent-2", "theme": "dark" } },
      "$type": "color"
    },
    "focus": {
      "$value": { "colorSpace": "srgb", "components": [0.5333, 0.7725, 0.8471], "alpha": 1 },
      "$description": "Dark-mode keyboard focus ring.",
      "$extensions": { "reference-ui": { "css_name": "--focus", "theme": "dark" } },
      "$type": "color"
    }
  }
}
